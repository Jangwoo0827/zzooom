{
  "manifest_version": 3,
  "name": "Fine Zoom",
  "version": "1.1",
  "description": "5%~1000% 줌, 1% 단위 조절",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fine Zoom",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  "commands": {
    "zoom-in":  { "suggested_key": { "default": "Alt+Shift+Up" },   "description": "1% 확대" },
    "zoom-out": { "suggested_key": { "default": "Alt+Shift+Down" }, "description": "1% 축소" },
    "zoom-reset": { "suggested_key": { "default": "Alt+Shift+0" },  "description": "100%로 초기화" },
    "zoom-area": { "suggested_key": { "default": "Alt+Shift+S" },  "description": "영역 확대창" }
  }
}
